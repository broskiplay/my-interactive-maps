{
  "name": "broskiplay-site",
  "private": true,
  "type": "module",
  "description": "Главная broskiplay.ru: React + TypeScript + Tailwind CSS, пререндер в статический index.html",
  "scripts": {
    "dev": "vite --config home/vite.config.ts",
    "typecheck": "tsc -p home/tsconfig.json --noEmit",
    "build:home": "npm run typecheck && node home/prerender.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
