{
  "name": "broskiplay-home",
  "private": true,
  "description": "Главная broskiplay.ru на Next.js (статический экспорт) + Tailwind CSS + shadcn/ui. Сборка кладёт index.html и _next/ в корень сайта.",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/install-home.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"app/**/*.{ts,tsx}\" \"components/**/*.tsx\" \"lib/*.ts\"",
    "site": "node scripts/assemble.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5"
  }
}
